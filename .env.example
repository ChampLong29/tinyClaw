# LLM Provider Configuration
# Requires the Anthropic Messages API or a wire-compatible endpoint.
ANTHROPIC_API_KEY=sk-ant-xxxxx
MODEL_ID=claude-sonnet-4-20250514

# Optional: custom base URL for an Anthropic Messages API-compatible provider.
# Leave unset when using the official Anthropic endpoint.
# ANTHROPIC_BASE_URL=https://example.com/anthropic

# Session identity boundary
# Safer default isolates the same platform user across bot accounts/channels.
# Options: per-peer | per-channel-peer | per-account-channel-peer | linked-global-user
# SESSION_SCOPE=per-account-channel-peer
# Increment when changing policy so historical sessions are never silently reused.
# SESSION_SCOPE_VERSION=1

# Telegram (optional, for s04_channels.py)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Feishu / Lark (optional, for s04_channels.py)
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx
# FEISHU_ENCRYPT_KEY=
# FEISHU_BOT_OPEN_ID=
# FEISHU_IS_LARK=false
# FEISHU_MODE=both              # long | webhook | both | off
# FEISHU_WEBHOOK_HOST=0.0.0.0
# FEISHU_WEBHOOK_PORT=8766
# FEISHU_WEBHOOK_PATH=/feishu/events
# FEISHU_REMINDER_TO=oc_xxxxxxxx_or_chat_id   # 可选: 固定接收提醒的飞书会话ID

# WeCom CLI bridge
# - TOOL: expose wecom-cli as callable tool for the model
# - POLL: whether to poll wecom-cli chat history as inbound channel
# Backward compatibility: WECOM_CLI_ENABLED still works as legacy master switch.
# WECOM_CLI_TOOL_ENABLED=true
# WECOM_CLI_POLL_ENABLED=false
# WECOM_CLI_ENABLED=true
# WECOM_CLI_BIN=wecom-cli
# WECOM_CLI_POLL_INTERVAL=3
# WECOM_CLI_HEALTH_LOG_INTERVAL=30
# WECOM_CLI_LOOKBACK_SECONDS=300
# WECOM_CLI_OVERLAP_SECONDS=5
# WECOM_CLI_DEBUG=false

# Work WeChat (optional, official send + normalized webhook inbound)
# WORKWECHAT_CORP_ID=wwxxxxxxxxxxxxxxxx
# WORKWECHAT_CORP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WORKWECHAT_AGENT_ID=1000002
# WORKWECHAT_MODE=long            # long | webhook | off
# WORKWECHAT_BOT_ID=AIBOTID
# WORKWECHAT_BOT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WORKWECHAT_WS_URL=wss://openws.work.weixin.qq.com
# WORKWECHAT_PING_INTERVAL_SEC=30
# WORKWECHAT_WEBHOOK_HOST=0.0.0.0
# WORKWECHAT_WEBHOOK_PORT=8767
# WORKWECHAT_WEBHOOK_PATH=/workwechat/events
# WORKWECHAT_WEBHOOK_TOKEN=change-me

# DingTalk (optional)
# DINGTALK_MODE=long             # long | webhook | off
# Long mode requires: pip install dingtalk-stream
# DINGTALK_CLIENT_ID=dingxxxxxxxxxxxxxxxx
# DINGTALK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Webhook mode:
# DINGTALK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# DINGTALK_SECRET=SECxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxxx  # optional, prefer this when available
# DINGTALK_API_BASE=https://oapi.dingtalk.com
# DINGTALK_WEBHOOK_HOST=0.0.0.0
# DINGTALK_WEBHOOK_PORT=8768
# DINGTALK_WEBHOOK_PATH=/dingtalk/events
# DINGTALK_WEBHOOK_TOKEN=change-me

# Heartbeat (optional, for s07_heartbeat_cron.py)
# HEARTBEAT_INTERVAL=1800
# HEARTBEAT_ACTIVE_START=9
# HEARTBEAT_ACTIVE_END=22

# Reminder poll interval in seconds (lower = more precise, higher = less load)
# REMINDER_CHECK_INTERVAL=15

# Optional; if omitted, a stable secret is generated under the runtime workspace.
# CONFIRMATION_TOKEN_SECRET=replace-with-at-least-16-random-bytes
